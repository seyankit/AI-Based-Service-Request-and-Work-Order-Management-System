    <servlet-class>
            ph.edu.htcgsc.serviceportal.servlet.ProfilePhotoServlet
        </servlet-class>
    <multipart-config>
      <max-file-size>5242880</max-file-size>
      <max-request-size>6291456</max-request-size>
      <file-size-threshold>0</file-size-threshold>
    </multipart-config>
  </servlet>
  <servlet>
    <servlet-name>ServiceRequestAttachmentServlet</servlet-name>
