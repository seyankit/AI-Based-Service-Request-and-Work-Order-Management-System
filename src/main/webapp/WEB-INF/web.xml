      <file-size-threshold>0</file-size-threshold>
    </multipart-config>
  </servlet>
  <servlet>
    <servlet-name>PersonnelManagementServlet</servlet-name>
    <servlet-class>
            ph.edu.htcgsc.serviceportal.servlet.PersonnelManagementServlet
        </servlet-class>
  </servlet>
  <!-- Servlet URL mappings -->
  <servlet>
    <servlet-name>ServiceRequestReviewServlet</servlet-name>
    <servlet-class>ph.edu.htcgsc.serviceportal.servlet.ServiceRequestReviewServlet</servlet-class>
  </servlet>
  <servlet>
    <servlet-name>ServiceRequestDuplicateServlet</servlet-name>
