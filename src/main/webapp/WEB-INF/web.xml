  <servlet>
    <servlet-name>RequestStatusHistoryServlet</servlet-name>
    <servlet-class>
            ph.edu.htcgsc.serviceportal.servlet.RequestStatusHistoryServlet
        </servlet-class>
  </servlet>
  <servlet>
    <servlet-name>AccountReviewServlet</servlet-name>
    <servlet-class>
