  <servlet-mapping>
    <servlet-name>ServiceRequestDraftServlet</servlet-name>
    <url-pattern>/api/service-request-drafts</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>ProfilePhotoServlet</servlet-name>
    <url-pattern>/api/profile/photo</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>ServiceRequestAttachmentServlet</servlet-name>
