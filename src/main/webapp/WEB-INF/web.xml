  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>PersonnelManagementServlet</servlet-name>
    <url-pattern>/api/personnel</url-pattern>
  </servlet-mapping>
  <!-- Session configuration -->
  <servlet-mapping>
    <servlet-name>ServiceRequestReviewServlet</servlet-name>
    <url-pattern>/api/service-request-reviews</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>ServiceRequestDuplicateServlet</servlet-name>
    <url-pattern>/api/service-request-duplicates</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>ApprovalServlet</servlet-name>
    <url-pattern>/api/approvals</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>WorkOrderServlet</servlet-name>
    <url-pattern>/api/work-orders</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>WorkOrderProgressServlet</servlet-name>
    <url-pattern>/api/work-order-progress</url-pattern>
  </servlet-mapping>
  <session-config>
    <session-timeout>30</session-timeout>
    <cookie-config>
      <http-only>true</http-only>
    </cookie-config>
    <tracking-mode>COOKIE</tracking-mode>
  </session-config>
  <welcome-file-list>
    <welcome-file>index.html</welcome-file>
  </welcome-file-list>

   <servlet>
      <servlet-name>NotificationServlet</servlet-name>
      <servlet-class>ph.edu.htcgsc.serviceportal.servlet.NotificationServlet</servlet-class>
   </servlet>

   <servlet-mapping>
      <servlet-name>NotificationServlet</servlet-name>
      <url-pattern>/api/notifications</url-pattern>
   </servlet-mapping>
</web-app>
